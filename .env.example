# ═══════════════════════════════════════════════════════════════════════════
# Modèle des variables d'environnement — À COPIER en `.env.local` (ignoré par git)
# et à reporter dans les variables du fournisseur d'hébergement.
#
# ⚠️ Les coordonnées des responsables ne sont PAS dans le code : le dépôt est public.
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase ────────────────────────────────────────────────────────────────
# En local : `supabase start` puis `supabase status -o env` donne API_URL et ANON_KEY.
# En production : tableau de bord Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── URL publique du site (SEO : canoniques, hreflang, sitemap) ──────────────
NEXT_PUBLIC_SITE_URL=https://qardanhassana.ci

# ── Coordonnées du bureau de l'ONG ─────────────────────────────────────────
# Format du téléphone : international sans espaces (+225XXXXXXXXXX).
# L'affichage « 07 47 00 83 83 » est DÉRIVÉ automatiquement, ne pas le saisir.
NEXT_PUBLIC_CONTACT_PCA_NAME=
NEXT_PUBLIC_CONTACT_PCA_PHONE=
NEXT_PUBLIC_CONTACT_SECRETAIRE_NAME=
NEXT_PUBLIC_CONTACT_SECRETAIRE_PHONE=
NEXT_PUBLIC_CONTACT_TRESORIER_NAME=
NEXT_PUBLIC_CONTACT_TRESORIER_PHONE=

# ── Divers ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ORG_EMAIL=contact@qardanhassana.ci
NEXT_PUBLIC_ORG_FACEBOOK=
