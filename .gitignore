node_modules/
.next/
out/
dist/
.env
.env.local
.data/
*.tsbuildinfo
.DS_Store

# ⚠️ Le CLI Supabase écrit ici les secrets de la pile locale — dont la clé
# `service_role`, qui contourne toutes les politiques RLS. En clair, et régénérés
# à chaque `supabase start` : ils n'ont rien à faire dans un dépôt.
supabase/.temp/
supabase/.branches/

# Journaux d'installation et de build, régénérables et bruyants dans les diffs.
*.log

# Caches Expo / outils
.expo/
.turbo/

# ── Projets natifs générés par `expo prebuild` ─────────────────────────────
# Reconstruits à la demande depuis app.json ; les versionner ferait diverger la
# configuration native de sa source (le « workflow managé » d'Expo).
apps/mobile/android/
apps/mobile/ios/

# ── Signature Android (EAS, credentialsSource: local) ──────────────────────
# La clé de signature et son mot de passe ne se versionnent JAMAIS : quiconque
# les détient peut publier une mise à jour se faisant passer pour l'application.
apps/mobile/credentials/
apps/mobile/credentials.json
