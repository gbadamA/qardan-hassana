# ═══════════════════════════════════════════════════════════════════════════
# Modèle des variables du MOBILE — À COPIER en `.env.local` (ignoré par git).
#
# ⚠️ Préfixe `EXPO_PUBLIC_`, pas `NEXT_PUBLIC_` : c'est Metro qui remplace ces
# expressions au build, et il ne connaît que ce préfixe-là. Le code partagé
# (`packages/shared/src/org.ts`) lit les deux, mais seul `EXPO_PUBLIC_*` est
# effectivement remplacé côté mobile.
#
# ⚠️ Tout ce qui porte ce préfixe part dans le bundle installé sur le téléphone.
# Ne jamais y mettre autre chose que des valeurs publiables.
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase ────────────────────────────────────────────────────────────────
# FACULTATIF : `app.json > extra` pointe déjà sur le projet en ligne, et suffit.
# Ces variables ne servent qu'à viser une AUTRE base sans toucher au code —
# une base locale (`supabase status -o env`) ou une préproduction. Elles priment
# sur `extra`. Après changement, relancer Expo : les valeurs sont figées au build.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Coordonnées du bureau de l'ONG ─────────────────────────────────────────
# Sans elles, l'écran d'accueil affiche « Responsable à renseigner » et un
# numéro de démonstration. Format international sans espaces (+225XXXXXXXXXX) :
# l'affichage « 07 47 00 83 83 » est DÉRIVÉ, ne pas le saisir.
EXPO_PUBLIC_CONTACT_PCA_NAME=
EXPO_PUBLIC_CONTACT_PCA_PHONE=
EXPO_PUBLIC_CONTACT_SECRETAIRE_NAME=
EXPO_PUBLIC_CONTACT_SECRETAIRE_PHONE=
EXPO_PUBLIC_CONTACT_TRESORIER_NAME=
EXPO_PUBLIC_CONTACT_TRESORIER_PHONE=

# ── Divers ─────────────────────────────────────────────────────────────────
EXPO_PUBLIC_ORG_EMAIL=contact@qardanhassana.ci
