{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@qardan/design-tokens": [
        "../../packages/design-tokens/src/index.ts"
      ],
      "@qardan/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@qardan/supabase": [
        "../../packages/supabase/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ]
}
